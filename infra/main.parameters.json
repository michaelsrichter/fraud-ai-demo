{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=eastus2}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "modelDeployments": {
      "value": [
        { "name": "gpt-5.4", "modelName": "gpt-5.4", "modelVersion": "2026-03-05", "capacity": 100 },
        { "name": "gpt-5.3-chat", "modelName": "gpt-5.3-chat", "modelVersion": "2026-03-03", "capacity": 100 },
        { "name": "gpt-5.4-mini", "modelName": "gpt-5.4-mini", "modelVersion": "2026-03-17", "capacity": 100 }
      ]
    }
  }
}
