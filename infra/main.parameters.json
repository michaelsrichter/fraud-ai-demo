{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=eastus2}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "modelDeployments": {
      "value": [
        { "name": "gpt-4.1", "modelName": "gpt-4.1", "modelVersion": "2025-04-14", "capacity": 100 },
        { "name": "o3", "modelName": "o3", "modelVersion": "2025-04-16", "capacity": 100 },
        { "name": "o4-mini", "modelName": "o4-mini", "modelVersion": "2025-04-16", "capacity": 100 }
      ]
    }
  }
}
