{
  "name": "Fraud AI Demo",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/azure/azure-dev/azd:1": {},
    "ghcr.io/jlaundry/devcontainer-features/azure-functions-core-tools:1": {
      "version": "4"
    }
  },

  "forwardPorts": [5173, 7071, 10000, 10001, 10002],
  "portsAttributes": {
    "5173": { "label": "Frontend (Vite)", "onAutoForward": "openBrowser" },
    "7071": { "label": "Functions API", "onAutoForward": "silent" },
    "10000": { "label": "Azurite Blob", "onAutoForward": "silent" },
    "10001": { "label": "Azurite Queue", "onAutoForward": "silent" },
    "10002": { "label": "Azurite Table", "onAutoForward": "silent" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-azuretools.vscode-azurefunctions",
        "Azurite.azurite",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.azure-dev",
        "github.copilot",
        "github.copilot-chat"
      ],
      "settings": {
        "dotnet.defaultSolution": "backend/fraud-ai-demo.slnx"
      }
    }
  }
}
