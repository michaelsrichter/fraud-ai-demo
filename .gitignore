# =============================================================================
# .gitignore — fraud-ai-demo
# Covers: OS noise, editors, .NET (incl. Azure Functions isolated worker),
# Node/React frontends (CRA, Vite, Next.js), and local Azure tooling.
# =============================================================================

# -----------------------------------------------------------------------------
# OS / editor noise
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~

# VS Code: keep shared settings/launch configs, ignore per-user state
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/

# JetBrains / Rider / IntelliJ
.idea/
*.iml
*.iws
*.ipr

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# =============================================================================
# .NET (Azure Functions isolated worker, class libs, test projects)
# =============================================================================

# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/

# Roslyn / build cache
.vs/
*.binlog
*.tlog
*.cache

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# Test results / coverage
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
*.opencover.xml
*.gcda
*.gcno
.coverage
.coveragerc
TestResults/

# Diagnostics & profiler
*.psess
*.vsp
*.vspx
*.sap
*.dmp
*.pdb
!**/wwwroot/**/*.pdb

# ASP.NET / Blazor
wwwroot/dist/
appsettings.*.local.json

# Azure Functions
local.settings.json
local.settings.*.json
.azurefunctions/
bin/
obj/
.python_packages/
__azurite_db*__.json
__blobstorage__/
__queuestorage__/
.azurite/

# =============================================================================
# Node / React (CRA, Vite, Next.js, generic)
# =============================================================================

# Dependencies
node_modules/
.pnp/
.pnp.js
.pnp.cjs
.yarn/install-state.gz
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.pnpm-store/

# Build output
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.turbo/
.parcel-cache/
.vite/
storybook-static/

# Test / coverage
coverage/
.nyc_output/
*.lcov

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Caches
.eslintcache
.stylelintcache
.cache/
.tsbuildinfo
*.tsbuildinfo

# =============================================================================
# Environment / secrets (NEVER commit)
# =============================================================================
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.pfx
secrets/
.secrets/

# =============================================================================
# Azure tooling (azd, Bicep, deployment)
# =============================================================================
.azure/
azure.env
*.azurePubxml
*.publishsettings
PublishProfiles/
*.zip
publish/

# Bicep build artifacts (compiled ARM JSON next to .bicep)
main.json
!docs/**/main.json

# =============================================================================
# Misc
# =============================================================================
*.tmp
*.temp
*.bak
*.orig
*.rej
